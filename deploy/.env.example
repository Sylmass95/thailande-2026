# Rempli par install.sh
REPO_DIR=
GITHUB_REPO=
GITHUB_TOKEN=

# Fréquence de vérification des mises à jour (secondes).
UPDATE_INTERVAL=10

# Assistant IA : clé API Claude (console.anthropic.com → API Keys). Vide = assistant désactivé.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Code d'accès demandé par l'app (fortement conseillé si le serveur est joignable depuis Internet).
APP_TOKEN=
# Recherche web pour les restaurants (à activer aussi dans la console Anthropic).
WEB_SEARCH=true

# Tricount : lien de partage par défaut (facultatif).
TRICOUNT_LINK=

# Option Cloudflare Tunnel.
TUNNEL_TOKEN=
